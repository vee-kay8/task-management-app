# ============================================================
# FLAKE8 CONFIGURATION
# ============================================================
# Flake8 checks your Python code for style and quality issues
# Documentation: https://flake8.pycqa.org/en/latest/

[flake8]
# ============================================================
# LINE LENGTH
# ============================================================
# max-line-length: Maximum characters per line
# PEP 8 recommends 79, but 100 is more practical for modern screens
# Black (code formatter) uses 88 by default, but we set 100
max-line-length = 100

# ============================================================
# EXCLUDED DIRECTORIES
# ============================================================
# exclude: Directories/files to ignore when checking
# Flake8 won't check these folders at all

exclude =
    # Version control
    .git,
    .github,
    
    # Python cache files (auto-generated)
    __pycache__,
    *.pyc,
    
    # Virtual environments
    venv,
    env,
    ENV,
    .venv,
    
    # Database migrations (auto-generated by Alembic)
    # These files are managed by Flask-Migrate, don't lint them
    migrations,
    
    # Build artifacts
    build,
    dist,
    *.egg-info,
    
    # IDE and editor folders
    .vscode,
    .idea,
    
    # Test coverage reports
    htmlcov,
    .coverage,
    
    # Documentation
    docs

# ============================================================
# IGNORED ERROR CODES
# ============================================================
# ignore: Error codes to suppress
# Full list: https://www.flake8rules.com/

ignore =
    # E203: Whitespace before ':'
    # Black (formatter) sometimes adds space before colon in slices
    # Example: mylist[start : end] - Black likes this, flake8 doesn't
    # Ignoring this prevents conflict between Black and Flake8
    E203,
    
    # W503: Line break before binary operator
    # Old PEP 8 style, but modern Python prefers break BEFORE operator
    # Old: result = (first_value +
    #               second_value)
    # New: result = (first_value
    #               + second_value)  ✓ More readable
    W503,
    
    # E501: Line too long
    # We already set max-line-length, no need for this error
    # E501,  # Uncomment if you want to allow any line length
    
    # E402: Module level import not at top of file
    # Sometimes you need to import after setting up environment
    # E402,  # Uncomment if needed

# ============================================================
# ERROR CODES TO ENFORCE (NOT IGNORED)
# ============================================================
# These are some important errors flake8 will catch:
#
# E101: Indentation contains mixed spaces and tabs
# E111: Indentation is not a multiple of 4
# E401: Multiple imports on one line
# E701: Multiple statements on one line (colon)
# E702: Multiple statements on one line (semicolon)
# E703: Statement ends with a semicolon
# E711: Comparison to None should be 'if cond is None:'
# E712: Comparison to True should be 'if cond is True:' or 'if cond:'
# E713: Test for membership should be 'not in'
# E714: Test for object identity should be 'is not'
# E721: Do not compare types, use 'isinstance()'
# E722: Do not use bare 'except'
# E731: Do not assign a lambda expression, use a def
# F401: Module imported but unused
# F403: 'from module import *' used; unable to detect undefined names
# F404: Future import(s) after other statements
# F405: Name may be undefined, or defined from star imports
# F811: Redefinition of unused name
# F821: Undefined name
# F822: Undefined name in __all__
# F823: Local variable referenced before assignment
# F831: Duplicate argument name in function definition
# F841: Local variable assigned but never used

# ============================================================
# COMPLEXITY SETTINGS
# ============================================================
# max-complexity: McCabe complexity threshold
# Measures how complex your functions are (number of paths through code)
# Lower = simpler, easier to test
# Recommended: 10-15 for most projects

max-complexity = 10
# If a function exceeds this, flake8 warns you to break it into smaller functions
# Example: Function with 5 nested if statements = high complexity

# ============================================================
# PER-FILE IGNORES
# ============================================================
# per-file-ignores: Ignore specific errors in specific files
# Format: path/to/file.py:ERROR_CODE

per-file-ignores =
    # __init__.py files often have unused imports (re-exporting modules)
    # F401: Module imported but unused
    __init__.py:F401,
    
    # Test files might import fixtures they don't directly use
    # F401: Module imported but unused
    # F811: Redefinition of unused name (from pytest fixtures)
    tests/*:F401,F811

# ============================================================
# DOCSTRING SETTINGS (requires flake8-docstrings plugin)
# ============================================================
# docstring-convention: Which docstring style to enforce
# Options: google, numpy, pep257
# Google style is most readable for most developers

docstring-convention = google

# ============================================================
# IMPORT ORDER (requires flake8-import-order plugin)
# ============================================================
# import-order-style: How imports should be organized
# Options: google, pep8, cryptography, edited, appnexus
# We use 'google' style

# import-order-style = google

# ============================================================
# EXAMPLE ERRORS CAUGHT
# ============================================================
# 1. Unused import:
#    import os  # F401 if 'os' is never used
#
# 2. Undefined variable:
#    print(usernane)  # F821 (typo: should be 'username')
#
# 3. Too complex function:
#    def process_data(data):  # C901 if too many if/else
#        if condition1:
#            if condition2:
#                if condition3:
#                    ...  # Too many nested conditions
#
# 4. Bare except:
#    try:
#        risky_operation()
#    except:  # E722 - should specify exception type
#        pass
#
# 5. Comparison to True:
#    if is_valid == True:  # E712 - should be 'if is_valid:'
#
# 6. Lambda assignment:
#    func = lambda x: x + 1  # E731 - use 'def func(x): return x + 1'
# ============================================================

# ============================================================
# USAGE EXAMPLES
# ============================================================
# Check all Python files in current directory:
#   flake8
#
# Check specific file:
#   flake8 app/models/user.py
#
# Check with statistics:
#   flake8 --statistics
#
# Show only error codes (no descriptions):
#   flake8 --show-source
#
# Count errors by type:
#   flake8 --count
#
# Generate HTML report (requires flake8-html):
#   flake8 --format=html --htmldir=flake8-report
# ============================================================
